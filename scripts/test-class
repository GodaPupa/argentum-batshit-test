#!/usr/bin/env python3
"""Run one test class without knowing which module owns it.

The card scenario suite lives in a `tests` module per era under `mtg-sets/`, so
`:rules-engine:test --tests Foo` no longer finds most tests. This finds the file, maps it back to
its Gradle project, and runs only that project's test task — which is also the fast path, because
only that one module's (bounded) test compilation has to be up to date.

Usage:
    scripts/test-class MyrIncubatorScenarioTest
    scripts/test-class 'Layer*Test'          # globs work; every matching module is run
"""

from __future__ import annotations

import fnmatch
import os
import re
import subprocess
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent


def gradle_project_for(path: Path) -> str | None:
    """Map a source file to the Gradle project path that compiles it."""
    rel = path.relative_to(REPO_ROOT)
    parts = rel.parts
    try:
        src = parts.index("src")
    except ValueError:
        return None
    return ":" + ":".join(parts[:src])


def main(argv: list[str]) -> int:
    if not argv:
        print(__doc__, file=sys.stderr)
        return 2
    pattern = argv[0]
    gradle_args = argv[1:]

    sources: list[Path] = []
    for dirpath, dirnames, filenames in os.walk(REPO_ROOT):
        dirnames[:] = [
            d for d in dirnames
            if d not in {"build", "node_modules", ".git", ".gradle", ".claude", "temp"}
        ]
        for fn in filenames:
            if fn.endswith(".kt"):
                sources.append(Path(dirpath) / fn)

    # One file per test class is the convention, so the file name finds it. A handful of files
    # declare a second test class, so fall back to searching declarations before giving up.
    matches = [p for p in sources if fnmatch.fnmatch(p.name[:-3], pattern)]
    if not matches:
        decl = re.compile(r"^\s*(?:internal\s+|private\s+)?class\s+(\w+)", re.M)
        for p in sources:
            try:
                text = p.read_text(encoding="utf-8", errors="replace")
            except OSError:
                continue
            if any(fnmatch.fnmatch(name, pattern) for name in decl.findall(text)):
                matches.append(p)

    if not matches:
        print(f"test-class: no test class matching '{pattern}' under {REPO_ROOT}", file=sys.stderr)
        return 1

    projects = sorted({p for p in (gradle_project_for(m) for m in matches) if p})
    if not projects:
        print(f"test-class: '{pattern}' matched {len(matches)} file(s) but none in a Gradle module",
              file=sys.stderr)
        return 1

    tasks: list[str] = []
    for proj in projects:
        tasks += [f"{proj}:test", "--tests", pattern]

    print(f"test-class: {pattern} -> {' '.join(projects)}", file=sys.stderr)
    return subprocess.call(
        [str(REPO_ROOT / "scripts" / "gradle-locked"), *tasks, *gradle_args],
        cwd=REPO_ROOT,
    )


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
