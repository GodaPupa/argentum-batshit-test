        "patch": "@@ -0,0 +1,155 @@\n+name: Manual target-slot structural prerequisite R1\n+on:\n+  push:\n+    branches: [validation/manual-target-slot-plan-r1-20261023]\n+    paths: ['.github/workflows/manual-target-slot-plan-r1-20261023.yml']\n+permissions: {contents: read}\n+concurrency:\n+  group: manual-transmission-engine-qualification\n+  cancel-in-progress: false\n+env:\n+  SOURCE: 5bc1b733d3e19fee4da7e33174bf4a480bd92812\n+  SOURCE_TREE: acc3ced89285f9c90860f99ca7515ac5c7bb3ff3\n+  WORKFLOW: .github/workflows/manual-target-slot-plan-r1-20261023.yml\n+  RECORD: experiments/manual-transmission/research/target-slot-plan-r1-20261023\n+  EVIDENCE: manual-target-slot-evidence\n+  PRODUCTION: rules-engine/src/main/kotlin/com/wingedsheep/engine/mechanics/targeting/TargetSlotPlan.kt\n+  GRADLE_OPTS: -Dorg.gradle.daemon=false\n+  GRADLE_LOCK_SLOTS: '1'\n+jobs:\n+  verify:\n+    if: github.run_number == 1 && github.run_attempt == 1\n+    runs-on: ubuntu-latest\n+    timeout-minutes: 120\n+    steps:\n+      - uses: actions/checkout@v4\n+        with: {persist-credentials: false, fetch-depth: 0}\n+      - uses: actions/setup-java@v4\n+        with: {distribution: temurin, java-version: '21'}\n+      - uses: gradle/actions/setup-gradle@v4\n+      - name: Install locked recipe runner\n+        run: |\n+          sudo apt-get update\n+          sudo apt-get install -y just\n+          command -v flock\n+          mkdir -p \"$HOME/.cache/argentum\" \"$EVIDENCE\"\n+      - name: Bind six additive files, exact source and protected baseline\n+        run: python3 \"$RECORD/gate.py\" bind\n+      - name: Apply deliberate compiled no-update mutation and execute two witnesses\n+        id: mutation\n+        run: |\n+          python3 \"$RECORD/gate.py\" prepare mutation\n+          python3 \"$RECORD/gate.py\" mutate\n+          set +e\n+          flock -x -w 1800 \"$HOME/.cache/argentum/manual-transmission.lock\" just --working-directory \"$GITHUB_WORKSPACE\" --justfile \"$EVIDENCE/validation.just\" mutation 2>&1 | tee \"$EVIDENCE/mutation/gradle.log\"\n+          rc=${PIPESTATUS[0]}\n+          printf '%s\\n' \"$rc\" > \"$EVIDENCE/mutation/exit.txt\"\n+          exit 0\n+      - name: Require two precise behavioral assertion failures, not compilation errors\n+        if: always() && steps.mutation.outcome != 'skipped'\n+        run: python3 \"$RECORD/gate.py\" receive mutation\n+      - name: Restore exact candidate and rebind before any positive testing\n+        if: always()\n+        run: |\n+          git checkout \"$SOURCE\" -- \"$PRODUCTION\"\n+          python3 \"$RECORD/gate.py\" bind\n+      - name: Focused 712 cases with strict original report receiving\n+        id: focused\n+        run: |\n+          python3 \"$RECORD/gate.py\" prepare focused\n+          set +e\n+          flock -x -w 1800 \"$HOME/.cache/argentum/manual-transmission.lock\" just --working-directory \"$GITHUB_WORKSPACE\" --justfile \"$EVIDENCE/validation.just\" focused 2>&1 | tee \"$EVIDENCE/focused/gradle.log\"\n+          rc=${PIPESTATUS[0]}\n+          printf '%s\\n' \"$rc\" > \"$EVIDENCE/focused/exit.txt\"\n+          python3 \"$RECORD/gate.py\" receive focused\n+          audit_rc=$?\n+          if test \"$rc\" != 0; then exit \"$rc\"; fi\n+          exit \"$audit_rc\"\n+      - name: Broad engine and nine card-era regressions\n+        id: broad\n+        run: |\n+          python3 \"$RECORD/gate.py\" prepare broad\n+          set +e\n+          flock -x -w 1800 \"$HOME/.cache/argentum/manual-transmission.lock\" just --working-directory \"$GITHUB_WORKSPACE\" --justfile \"$EVIDENCE/validation.just\" broad 2>&1 | tee \"$EVIDENCE/broad/gradle.log\"\n+          rc=${PIPESTATUS[0]}\n+          printf '%s\\n' \"$rc\" > \"$EVIDENCE/broad/exit.txt\"\n+          python3 \"$RECORD/gate.py\" receive broad\n+          audit_rc=$?\n+          if test \"$rc\" != 0; then exit \"$rc\"; fi\n+          exit \"$audit_rc\"\n+      - name: Ordinary whole-project build and exact 43 historical skips\n+        id: ordinary\n+        run: |\n+          python3 \"$RECORD/gate.py\" prepare ordinary\n+          set +e\n+          flock -x -w 1800 \"$HOME/.cache/argentum/manual-transmission.lock\" just --working-directory \"$GITHUB_WORKSPACE\" --justfile \"$EVIDENCE/validation.just\" ordinary 2>&1 | tee \"$EVIDENCE/ordinary/gradle.log\"\n+          rc=${PIPESTATUS[0]}\n+          printf '%s\\n' \"$rc\" > \"$EVIDENCE/ordinary/exit.txt\"\n+          python3 \"$RECORD/gate.py\" receive ordinary\n+          audit_rc=$?\n+          if test \"$rc\" != 0; then exit \"$rc\"; fi\n+          exit \"$audit_rc\"\n+      - name: Build Oracle Assay CLI\n+        id: assay_build\n+        run: |\n+          mkdir -p \"$EVIDENCE/assay\"\n+          set +e\n+          flock -x -w 1800 \"$HOME/.cache/argentum/manual-transmission.lock\" just --working-directory \"$GITHUB_WORKSPACE\" --justfile \"$EVIDENCE/validation.just\" assay-build 2>&1 | tee \"$EVIDENCE/assay/build.log\"\n+          rc=${PIPESTATUS[0]}\n+          printf '%s\\n' \"$rc\" > \"$EVIDENCE/assay/build-exit.txt\"\n+          exit \"$rc\"\n+      - name: Assay 2000-card corpus and preserve its exact original bytes\n+        run: |\n+          set +e\n+          flock -x -w 1800 \"$HOME/.cache/argentum/manual-transmission.lock\" just --working-directory \"$GITHUB_WORKSPACE\" --justfile \"$EVIDENCE/validation.just\" assay 2>&1 | tee \"$EVIDENCE/assay/gate.log\"\n+          rc=${PIPESTATUS[0]}\n+          printf '%s\\n' \"$rc\" > \"$EVIDENCE/assay/gate-exit.txt\"\n+          capture_rc=0\n+          corpus=\"$HOME/.cache/scryfall/_bulk-oracle-cards.jsonl.gz\"\n+          if test -f \"$corpus\"; then\n+            sha256sum \"$corpus\" > \"$EVIDENCE/assay/oracle-bulk-sha256.txt\" || capture_rc=1\n+            wc -c \"$corpus\" > \"$EVIDENCE/assay/oracle-bulk-bytes.txt\" || capture_rc=1\n+            cp \"$corpus\" \"$EVIDENCE/assay/oracle-bulk-corpus.jsonl.gz\" || capture_rc=1\n+          else\n+            capture_rc=1\n+          fi\n+          printf '%s\\n' \"$capture_rc\" > \"$EVIDENCE/assay/corpus-capture-exit.txt\"\n+          if test \"$capture_rc\" != 0; then exit \"$capture_rc\"; fi\n+          exit \"$rc\"\n+      - name: Preserve full original differential without reclassification\n+        run: |\n+          set +e\n+          flock -x -w 1800 \"$HOME/.cache/argentum/manual-transmission.lock\" just --working-directory \"$GITHUB_WORKSPACE\" --justfile \"$EVIDENCE/validation.just\" assay-differential 2>&1 | tee \"$EVIDENCE/assay/differential.log\"\n+          rc=${PIPESTATUS[0]}\n+          printf '%s\\n' \"$rc\" > \"$EVIDENCE/assay/differential-exit.txt\"\n+          exit \"$rc\"\n+      - name: Receive Assay metrics and preserve all 51 original findings\n+        if: always() && steps.assay_build.outcome != 'skipped'\n+        run: python3 \"$RECORD/gate.py\" assay\n+      - name: Recheck exact candidate and protected source bytes\n+        if: always()\n+        run: python3 \"$RECORD/gate.py\" bind\n+      - name: Preserve protocols, literal source delta, and unfinished-stage disposition\n+        if: always()\n+        run: |\n+          mkdir -p \"$EVIDENCE/protocol\"\n+          cp \"$RECORD/PROTOCOL.json\" \"$RECORD/DESIGN.md\" \"$RECORD/gate.py\" \"$EVIDENCE/protocol/\"\n+          cp \"$WORKFLOW\" \"$EVIDENCE/protocol/WORKFLOW.yml\"\n+          git rev-parse HEAD \"$SOURCE^{tree}\" > \"$EVIDENCE/SOURCE_PINS.txt\"\n+          git diff --name-status 0b5018a0df392acc96d8b38e20dd72ccae3ff48a \"$SOURCE\" > \"$EVIDENCE/SOURCE_DELTA.txt\"\n+          git status --porcelain --untracked-files=no > \"$EVIDENCE/FINAL_TRACKED_CHANGES.txt\"\n+          python3 - <<'PY'\n+          from pathlib import Path\n+          import json\n+          root=Path('manual-target-slot-evidence')\n+          results={stage:(root/stage/'SUMMARY.json').exists() for stage in ['mutation','focused','broad','ordinary']}\n+          (root/'DISPOSITION.json').write_text(json.dumps({'original_reports_present':results,'assay_receipt_present':(root/'assay'/'RECEIVING.json').exists(),'scope':'STRUCTURAL_PREREQUISITE_ONLY_NOT_LIVE_RETARGETING_NOT_SPELLSKITE','component_adopted':False,'official_games':0,'official_seeds':0,'precision_reserved':2},indent=2)+'\\n')\n+          PY\n+          python3 \"$RECORD/gate.py\" hash\n+      - uses: actions/upload-artifact@v4\n+        if: always()\n+        with:\n+          name: manual-target-slot-plan-r1-${{ github.run_id }}\n+          path: manual-target-slot-evidence/\n+          retention-days: 90\n+          if-no-files-found: error"
      }
    ]
  }
