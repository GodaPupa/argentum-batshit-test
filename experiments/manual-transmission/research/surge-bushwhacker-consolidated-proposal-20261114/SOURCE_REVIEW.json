      ],
      "finding": "Existing serializable conditional SelfAlternativeCost plus explicit SELF_ALTERNATIVE is sufficient for own-player Surge composition. No new enum, keyword, serializer or team model is required for this bounded grant."
    },
    {
      "boundary": "enumeration and authorization",
      "files": [
        "rules-engine/src/main/kotlin/com/wingedsheep/engine/legalactions/enumerators/CastSpellEnumerator.kt",
