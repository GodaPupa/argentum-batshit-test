        "patch": "@@ -0,0 +1,45 @@\n+name: Manual Disciple runtime early R1\n+on:\n+  push:\n+    branches: [validation/manual-disciple-runtime-early-r1-20261101]\n+    paths: ['.github/workflows/manual-disciple-runtime-early-r1-20261101.yml']\n+permissions: {contents: read}\n+concurrency:\n+  group: manual-transmission-engine-qualification\n+  cancel-in-progress: false\n+env:\n+  SOURCE: 80b5a52d775dad05801b103ee5e12c0e31edcf39\n+  SOURCE_TREE: c8e69d893d615b2c98583fc547db9e3d6d7f3bbe\n+  WORKFLOW: .github/workflows/manual-disciple-runtime-early-r1-20261101.yml\n+  RECORD: experiments/manual-transmission/research/disciple-runtime-early-r1-20261101\n+  GRADLE_OPTS: -Dorg.gradle.daemon=false\n+  GRADLE_LOCK_SLOTS: '1'\n+jobs:\n+  verify:\n+    if: github.run_number == 1 && github.run_attempt == 1\n+    runs-on: ubuntu-latest\n+    timeout-minutes: 120\n+    steps:\n+      - uses: actions/checkout@v4\n+        with: {persist-credentials: false, fetch-depth: 0}\n+      - uses: actions/setup-java@v4\n+        with: {distribution: temurin, java-version: '21'}\n+      - uses: gradle/actions/setup-gradle@v4\n+      - uses: actions/setup-node@v4\n+        with: {node-version: '22', cache: npm, cache-dependency-path: web-client/package-lock.json}\n+      - name: Install approved locked recipe runner\n+        run: |\n+          sudo apt-get update\n+          sudo apt-get install -y just\n+          command -v flock\n+          mkdir -p \"$HOME/.cache/argentum\"\n+      - name: Compile every diagnostic form before original behavioral observations\n+        run: flock -x -w 1800 \"$HOME/.cache/argentum/manual-transmission.lock\" python3 \"$RECORD/run.py\"\n+      - uses: actions/upload-artifact@v4\n+        if: always()\n+        with:\n+          name: manual-disciple-runtime-early-r1-${{ github.run_id }}\n+          path: manual-disciple-runtime-early-r1-evidence/\n+          include-hidden-files: true\n+          if-no-files-found: error\n+          retention-days: 90"
      }
    ]
  },
