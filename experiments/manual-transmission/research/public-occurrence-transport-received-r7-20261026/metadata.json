      {
        "sha": "89e89eff96331d9c3a74065029647a1459aa862e",
        "filename": ".github/workflows/argentum-c4-cold-compile-20261015.yml",
        "status": "added",
        "additions": 86,
        "deletions": 0,
        "changes": 86,
        "blob_url": "https://github.com/GodaPupa/argentum-batshit-test/blob/37a603617a03dfd2d81b39dae004f7f336a70dfc/.github%2Fworkflows%2Fargentum-c4-cold-compile-20261015.yml",
        "raw_url": "https://github.com/GodaPupa/argentum-batshit-test/raw/37a603617a03dfd2d81b39dae004f7f336a70dfc/.github%2Fworkflows%2Fargentum-c4-cold-compile-20261015.yml",
        "contents_url": "https://api.github.com/repos/GodaPupa/argentum-batshit-test/contents/.github%2Fworkflows%2Fargentum-c4-cold-compile-20261015.yml?ref=37a603617a03dfd2d81b39dae004f7f336a70dfc",
        "patch": "@@ -0,0 +1,86 @@\n+name: ARGENTUM C4 cold compile only 20261015\n+on:\n+  workflow_dispatch:\n+    inputs:\n+      approval:\n+        description: Exact source-bound C4 compile-only acknowledgement\n+        required: true\n+        type: string\n+permissions:\n+  contents: read\n+concurrency:\n+  group: argentum-c4-cold-compile-only-20261015\n+  cancel-in-progress: false\n+jobs:\n+  cold-compile:\n+    runs-on: ubuntu-24.04\n+    timeout-minutes: 20\n+    strategy:\n+      fail-fast: false\n+      max-parallel: 2\n+      matrix:\n+        revision: [R5, R6]\n+    steps:\n+      - name: Fail-closed original and approval gate before downloads\n+        env:\n+          APPROVAL: ${{ inputs.approval }}\n+          WORKFLOW_REF: ${{ github.workflow_ref }}\n+        shell: bash\n+        run: |\n+          set -euo pipefail\n+          test \"$GITHUB_REPOSITORY\" = GodaPupa/argentum-batshit-test\n+          test \"$GITHUB_EVENT_NAME\" = workflow_dispatch\n+          test \"$GITHUB_REF\" = refs/heads/infra/argentum-c4-cold-compile-20261015\n+          test \"$GITHUB_RUN_NUMBER/$GITHUB_RUN_ATTEMPT\" = 1/1\n+          test \"$WORKFLOW_REF\" = GodaPupa/argentum-batshit-test/.github/workflows/argentum-c4-cold-compile-20261015.yml@refs/heads/infra/argentum-c4-cold-compile-20261015\n+          test \"$APPROVAL\" = C4_COMPILE_ONLY_ONCE_33e67f71931a1feaf335b1520be6ddba33e0c2b6\n+          mkdir \"$RUNNER_TEMP/c4-evidence\"\n+          printf '%s\\n' \"$GITHUB_SHA\" > \"$RUNNER_TEMP/c4-evidence/dispatch-commit.txt\"\n+          printf '%s\\n' \"$GITHUB_RUN_ID/$GITHUB_RUN_NUMBER/$GITHUB_RUN_ATTEMPT\" > \"$RUNNER_TEMP/c4-evidence/run-identity.txt\"\n+      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262\n+        with:\n+          ref: '33e67f71931a1feaf335b1520be6ddba33e0c2b6'\n+          persist-credentials: false\n+          fetch-depth: 1\n+      - name: Verify pinned implementation before toolchains\n+        shell: bash\n+        run: |\n+          set -euo pipefail\n+          test \"$(git rev-parse HEAD)\" = 33e67f71931a1feaf335b1520be6ddba33e0c2b6\n+          test \"$(git rev-parse 'HEAD^{tree}')\" = ed87a9c5ea6a60d968ee0856095b593a614f3816\n+          cd qualification/c4-preflight\n+          sha256sum -c SOURCE_SHA256SUMS\n+          cp SOURCE_SHA256SUMS \"$RUNNER_TEMP/c4-evidence/implementation-SHA256SUMS\"\n+          cp \"$GITHUB_EVENT_PATH\" \"$RUNNER_TEMP/c4-evidence/dispatch-event.json\"\n+      - uses: actions/setup-java@cf277c60eb25467037889841efdb72551f06f6c3\n+        with:\n+          distribution: microsoft\n+          java-version: '21'\n+      - name: Install exact official Just\n+        shell: bash\n+        run: |\n+          set -euo pipefail\n+          curl --fail --location --max-time 120 --output \"$RUNNER_TEMP/just.tar.gz\" https://github.com/casey/just/releases/download/1.59.0/just-1.59.0-x86_64-unknown-linux-musl.tar.gz\n+          echo \"409044617b6f06517c1035e55ca38c8c856ff8b650e41bc2aa1ef82d5903a23e  $RUNNER_TEMP/just.tar.gz\" | sha256sum -c -\n+          mkdir \"$RUNNER_TEMP/just-bin\"\n+          tar --no-same-owner -xzf \"$RUNNER_TEMP/just.tar.gz\" -C \"$RUNNER_TEMP/just-bin\" just\n+          echo \"$RUNNER_TEMP/just-bin\" >> \"$GITHUB_PATH\"\n+      - name: Compile frozen variant only\n+        env:\n+          C4_REVISION: ${{ matrix.revision }}\n+        run: python3 qualification/c4-preflight/preflight.py\n+      - name: Seal complete or partial evidence\n+        if: ${{ always() }}\n+        shell: bash\n+        run: |\n+          mkdir -p \"$RUNNER_TEMP/c4-evidence\"\n+          cd \"$RUNNER_TEMP/c4-evidence\"\n+          if ! test -f result.json; then printf '%s\\n' '{\"status\":\"INCOMPLETE\",\"reason\":\"preflight did not finish\"}' > result.json; fi\n+          find . -type f ! -name SHA256SUMS -print0 | sort -z | xargs -0 sha256sum > SHA256SUMS\n+      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02\n+        if: ${{ always() }}\n+        with:\n+          name: argentum-c4-${{ matrix.revision }}-${{ github.run_id }}-${{ github.run_attempt }}\n+          path: ${{ runner.temp }}/c4-evidence\n+          if-no-files-found: error\n+          retention-days: 90"
      }
