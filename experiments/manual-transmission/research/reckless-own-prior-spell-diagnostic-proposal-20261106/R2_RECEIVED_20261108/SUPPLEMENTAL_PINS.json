  "phase2": {
    "path": "experiments/manual-transmission-phase2/protocol-r1.json",
    "content": "{\n  \"schema\": \"manual-transmission-phase2-bounded-program-v1\",\n  \"protocol_id\": \"MT_V07_PHASE2_CEDH_MULTIPLAYER_R1_2026_09_24\",\n  \"state\": \"SEEDLESS_MULTIPLAYER_CAPABILITY_BATCH_IN_VALIDATION\",\n  \"phase1_source\": \"e7d37e2ea0f18dfa8d6b0fff68ef816b59555d2d\",\n  \"phase1_conclusion\": \"PASS_BOUNDED_POLICY_ELASTICITY_KEEP_V07\",\n  \"hardware_identifier\": \"6c28f0629d8ff0a859784f8c7dc0a47054b298d17c6b8e041a4a0a1d8744f111\",\n  \"hardware_disposition\": \"KEEP_V07\",\n  \"hardware_changes_authorized\": false,\n  \"gameplay_authorized\": false,\n  \"seed_generation_authorized\": false,\n  \"ruleset\": {\"status\": \"EFFECTIVE_SNAPSHOT_AND_DIGEST_REQUIRED\", \"future_effective_snapshot_must_not_be_labeled_current\": true},\n  \"gears\": [\"Cruise\", \"Sport\", \"Race\"],\n  \"pod_templates\": [\n    {\"id\": \"P01\", \"decks\": [\"manual-transmission-v07\", \"blue-farm\", \"rogsi\", \"kinnan\"]},\n    {\"id\": \"P02\", \"decks\": [\"manual-transmission-v07\", \"sisay\", \"magda\", \"hashaton\"]},\n    {\"id\": \"P03\", \"decks\": [\"manual-transmission-v07\", \"shorikai\", \"blue-farm\", \"rogsi\"]}\n  ],\n  \"opponent_admission\": \"Exact contemporary tournament 100s; Phase 1 source freezes are inventory candidates, not automatic Phase 2 gameplay admission. Selection and any pre-outcome source update must be recorded and frozen before gameplay. Never substitute for implementation convenience.\",\n  \"capability_pilot\": {\n    \"purpose\": \"defect discovery, not performance inference\",\n    \"initial_allocations_per_pod\": 4,\n    \"manual_seats\": [0, 1, 2, 3],\n    \"gears_per_allocation\": 3,\n    \"games_per_pod\": 12,\n    \"maximum_replacement_blocks_per_pod\": 1,\n    \"replacement_condition\": \"Only a documented outcome-relevant engine/pilot defect rejecting the entire capability block, corrected with independent deterministic evidence before a fresh seed freeze. An unfavorable clean result never permits replacement.\",\n    \"maximum_games_all_pods_including_replacement\": 72\n  },\n  \"primary\": {\n    \"unit\": \"matched initial-state allocation containing three gear games\",\n    \"all_seat_permutations_per_pod\": 24,\n    \"independent_allocations_per_seat_permutation\": 4,\n    \"allocations_per_pod\": 96,\n    \"gears_per_allocation\": 3,\n    \"games_per_pod\": 288,\n    \"total_games\": 864,\n    \"same_initial_state_across_gears\": true,\n    \"same_seed_reuse_allowed_only_inside_predeclared_three_gear_cluster\": true,\n    \"gear_execution_order\": \"All six gear permutations balanced across the 96 allocations per pod\",\n    \"opponent_policy_fixed_across_gears\": true,\n    \"policy_search_rng_separate_from_authoritative_game_rng\": true,\n    \"primary_contrast\": \"Race minus Sport, separately within each pod\",\n    \"secondary_contrasts\": [\"Sport minus Cruise\", \"Race minus Cruise\"],\n    \"inference\": \"Report per-pod/per-gear win fraction, draw fraction and denominators; descriptive 95% Wilson intervals and seat-stratified estimates. Report paired differences and paired intervals, preserving all three games as one allocation cluster. Apply Holm correction across all nine predeclared within-pod gear contrasts. No cross-pod pooled win rate. A 25% equal-player reference is descriptive, not a Tier-1 or viability threshold.\",\n    \"minimum_meaningful_gear_difference_absolute\": 0.10,\n    \"gear_claim_rule\": \"A material directional claim requires an adjusted interval excluding zero and evidence compatible with the predeclared 10 percentage-point margin; otherwise report uncertainty, not equivalence. No outcome-dependent extra sampling.\",\n    \"censoring\": \"No synthetic winner at a resource limit. Record cap/timeout as unresolved, never as loss or draw; report bounds counting unresolved as all losses versus all wins. Exact round/action/time caps must be bound in the production manifest before any official seed generation.\",\n    \"legitimate_draws\": \"Preserve rules-defined draws; no forced draws to end difficult games.\",\n    \"defect_rule\": \"Quarantine an outcome-relevant invalid primary pod block in full, preserve every record, stop its remaining execution, and do not replace or extend it in this program. Other independently clean pod blocks remain separately reportable.\",\n    \"stopping_rule\": \"Each admitted pod ends after its 96 matched allocations, or its predeclared terminal integrity/execution failure. No extension for precision, preferred outcomes, or hardware tuning. A missing/blocked pod is reported explicitly and cannot yield a complete-gauntlet claim. Capability blockage alone remains a checkpoint, not completed Phase 2.\"\n  },\n  \"required_telemetry\": [\"winner_or_rules_draw\", \"elimination_order\", \"turn_and_personal_round\", \"seat\", \"mulligans\", \"commander_casts_by_identity\", \"animar_removals\", \"successful_and_failed_win_attempts\", \"opposing_win_attempts_faced_and_stopped\", \"interaction_used\", \"interaction_held_but_unusable\", \"mana_stranded\", \"cards_stranded_by_color\", \"tutor_lines\", \"resource_conversion\", \"recovery_after_interaction\", \"recovery_after_commander_removal\", \"gear_decisions\", \"no_meaningful_decision_window\", \"loss_reason_with_evidence\", \"ordered_accepted_actions\", \"engine_pilot_and_input_hashes\"],\n  \"telemetry_rule\": \"Operational definitions and executable instrumentation must be tested and sealed before gameplay; unavailable measurements are null with a reason, never fabricated zeroes. Missing mandatory integrity fields block admission.\",\n  \"hardware_hypothesis_rule\": \"A repeated pattern requires at least five independent accepted allocation clusters across at least two Manual seats. Separate engine defects, pilot deficiencies and possible deck constraints; identical-gear paired observations are not independent replications. The pattern can justify a future hypothesis, not a causal swap claim or automatic v0.8 authorization.\",\n  \"production_preconditions\": [\"effective_rules_snapshot\", \"exact_100s_and_color_identity_legality\", \"all_card_and_mechanic_coverage\", \"four_player_partner_setup\", \"multiplayer_priority_and_APNAP\", \"elimination_and_win_resolution\", \"hidden_information_boundary\", \"London_free_mulligan\", \"executable_three_gear_pilots\", \"all_opponent_pilots\", \"simultaneous_threat_policy\", \"metrics_contract\", \"accepted_capability_pilot\", \"frozen_unique_fresh_seeds_and_exclusion_audit\", \"exact_seat_and_gear_schedule\", \"durable_attempt_before_initialization\", \"read_only_loader\", \"reviewed_automatic_one_shot_authorization\"],\n  \"official_counters\": {\"seeds_generated\": 0, \"attempts\": 0, \"games_initialized\": 0, \"actions\": 0, \"outcomes\": 0}\n}\n",
